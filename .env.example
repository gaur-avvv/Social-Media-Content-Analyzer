# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# LLAMA_CLOUD_API_KEY: Optional API key for official LlamaCloud / LlamaParse document extraction.
# Obtain from https://cloud.llamaindex.ai (or API Key settings in LlamaCloud).
# When provided, document payloads are parsed natively through LlamaCloud / LlamaParse.
# When omitted, the applet automatically falls back to the multimodal Gemini 2.5 Flash LlamaParse layer.
LLAMA_CLOUD_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Optional URL for Supabase PostgreSQL Knowledge Graph cluster.
# When omitted, the app automatically runs high-speed in-memory topological graph routing.
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Optional public anon key for Supabase Knowledge Graph cluster.
SUPABASE_ANON_KEY=""

